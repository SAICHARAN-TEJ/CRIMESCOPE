# ═══════════════════════════════════════════════════════════════════════
# CrimeScope v4.4.0 — Environment Variables (canonical set)
# Copy to .env and fill in secrets.
# Keep field-for-field in sync with backend/app/core/config.py
# (authoritative list lives in the Settings docstring).
# ═══════════════════════════════════════════════════════════════════════

# ── API / Deployment ───────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
AUTH_ENABLED=true                  # false = dev bypass (local-user principal)
# Comma-separated allowed browser origins; add the hosted frontend URL (e.g. https://crimescope-beta.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Admin bootstrap (seeded by app.db.init_db on first boot) ─────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=crimescope         # CHANGE ME before any real deployment

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE-ME-TO-A-SECURE-RANDOM-STRING   # >= 32 chars; required in production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM (OpenRouter) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-CHANGE-ME

# ── Postgres (structured metadata: jobs, scenarios, conversations) ────
DATABASE_URL=postgresql+asyncpg://crimescope:crimescope@postgres:5432/crimescope
POSTGRES_DB=crimescope
POSTGRES_USER=crimescope
POSTGRES_PASSWORD=crimescope
POSTGRES_PORT=5432

# ── Redis (cache, pub/sub, rate limiting) ─────────────────────────────
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=60

# ── Neo4j ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=crimescope

# ── MinIO Object Storage ──────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000           # internal (container network)
MINIO_ENDPOINT_PUBLIC=localhost:9000  # browser-reachable (pre-signed URLs)
MINIO_BUCKET=crimescope-evidence
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ── Downloads ─────────────────────────────────────────────────────────
MAX_DOWNLOAD_MB=200

# ── Frontend (build-time — set in Vercel, not here) ─────────────────────
# Backend origin when the frontend is hosted separately; empty/unset = same-origin proxying (Docker Nginx / Vite dev)
VITE_API_BASE_URL=
